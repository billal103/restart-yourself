# Copy this file to .env.local and fill in your own Supabase project's values.
# Never commit .env or .env.local — see .gitignore.
#
# Both variables below are the PUBLIC anon key and project URL — safe to ship
# to the browser by design (Supabase enforces access via Row Level Security,
# not by keeping these secret). NEVER put the service-role key in a VITE_*
# variable or anywhere in frontend code; it belongs only in Edge Function
# environment variables, configured through the Supabase dashboard/CLI.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Leave both unset to run the app fully on Milestone 1 mock data, with no
# backend required.
